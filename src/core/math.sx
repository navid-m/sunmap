val math = use("std/math")
val mem  = use("./mem.sx")

pub val PI: f64 = 3.141592653589793
pub val DEG: f64 = 0.017453292519943295
pub val EPS: f64 = 0.001

pub fn cos(x: f64) f64 = {
    return math.cos(x)
}

pub fn sin(x: f64) f64 = {
    return math.sin(x)
}

pub fn tan(x: f64) f64 = {
    return math.tan(x)
}

pub fn atan2(y: f64, x: f64) f64 = {
    return math.atan2(y, x)
}

pub fn sqrt(x: f64) f64 = {
    return math.sqrt(x)
}

pub fn fabs(x: f64) f64 = {
    return math.fabs(x)
}

pub fn floor(x: f64) f64 = {
    return math.floor(x)
}

pub fn ceil(x: f64) f64 = {
    return math.ceil(x)
}

pub fn round(x: f64) f64 = {
    return math.round(x)
}

pub fn trunc(x: f64) f64 = {
    return math.trunc(x)
}


pub type Vec3 = {
    x: mut f64
    y: mut f64
    z: mut f64
}

pub type Vec2 = {
    x: mut f64
    y: mut f64
}

pub type Ray = {
    origin: mut Vec3
    dir: mut Vec3
}

pub type Plane = {
    normal: mut Vec3
    dist: mut f64
}

// Column-major 4x4 matrix using explicit fields. Keeping the fields named
// avoids raw-array access in the middle of all the math.
pub type Mat4 = {
    m00: mut f64
    m01: mut f64
    m02: mut f64
    m03: mut f64
    m10: mut f64
    m11: mut f64
    m12: mut f64
    m13: mut f64
    m20: mut f64
    m21: mut f64
    m22: mut f64
    m23: mut f64
    m30: mut f64
    m31: mut f64
    m32: mut f64
    m33: mut f64
}

pub fn v2(x: f64, y: f64) Vec2 = {
    return Vec2{x: x, y: y}
}

pub fn v3(x: f64, y: f64, z: f64) Vec3 = {
    return Vec3{x: x, y: y, z: z}
}

pub fn v3_zero() Vec3 = {
    return Vec3{x: 0.0, y: 0.0, z: 0.0}
}

pub fn v3_add(a: Vec3, b: Vec3) Vec3 = {
    return Vec3{x: a.x + b.x, y: a.y + b.y, z: a.z + b.z}
}

pub fn v3_sub(a: Vec3, b: Vec3) Vec3 = {
    return Vec3{x: a.x - b.x, y: a.y - b.y, z: a.z - b.z}
}

pub fn v3_mul(a: Vec3, s: f64) Vec3 = {
    return Vec3{x: a.x * s, y: a.y * s, z: a.z * s}
}

pub fn v3_neg(a: Vec3) Vec3 = {
    return Vec3{x: -a.x, y: -a.y, z: -a.z}
}

pub fn v3_dot(a: Vec3, b: Vec3) f64 = {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

pub fn v3_cross(a: Vec3, b: Vec3) Vec3 = {
    return Vec3{
        x: a.y * b.z - a.z * b.y
        y: a.z * b.x - a.x * b.z
        z: a.x * b.y - a.y * b.x
    }
}

pub fn v3_len_sq(a: Vec3) f64 = {
    return a.x * a.x + a.y * a.y + a.z * a.z
}

pub fn v3_len(a: Vec3) f64 = {
    return math.sqrt(v3_len_sq(a))
}

pub fn v3_dist(a: Vec3, b: Vec3) f64 = {
    return v3_len(v3_sub(a, b))
}

pub fn v3_normalize(a: Vec3) Vec3 = {
    val l = v3_len(a)
    if l < 0.0000001 {
        return Vec3{x: 0.0, y: 0.0, z: 0.0}
    }
    return Vec3{x: a.x / l, y: a.y / l, z: a.z / l}
}

pub fn v3_lerp(a: Vec3, b: Vec3, t: f64) Vec3 = {
    return Vec3{
        x: a.x + (b.x - a.x) * t
        y: a.y + (b.y - a.y) * t
        z: a.z + (b.z - a.z) * t
    }
}

pub fn v3_abs(a: Vec3) Vec3 = {
    return Vec3{x: math.fabs(a.x), y: math.fabs(a.y), z: math.fabs(a.z)}
}

pub fn clampf(x: f64, lo: f64, hi: f64) f64 = {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

pub fn snapf(x: f64, step: f64) f64 = {
    if step <= 0.0001 {
        return x
    }
    return math.round(x / step) * step
}

pub fn snap_down(x: f64, step: f64) f64 = {
    if step <= 0.0001 {
        return x
    }
    return math.floor(x / step) * step
}

pub fn ray_plane(ray: Ray, plane: Plane) f64 = {
    val denom = v3_dot(plane.normal, ray.dir)
    if math.fabs(denom) < 0.000001 {
        return -1.0
    }
    val t = (plane.dist - v3_dot(plane.normal, ray.origin)) / denom
    if t < 0.0 {
        return -1.0
    }
    return t
}

pub fn plane_point_dist(plane: Plane, p: Vec3) f64 = {
    return v3_dot(plane.normal, p) - plane.dist
}

pub fn plane_from_points(a: Vec3, b: Vec3, c: Vec3) Plane = {
    val n = v3_normalize(v3_cross(v3_sub(b, a), v3_sub(c, a)))
    return Plane{normal: n, dist: v3_dot(n, a)}
}

pub fn tangent_for_normal(n: Vec3) Vec3 = {
    // Pick a stable tangent on the face plane.
    if math.fabs(n.z) > 0.9 {
        return Vec3{x: 1.0, y: 0.0, z: 0.0}
    }
    val t = v3_cross(n, Vec3{x: 0.0, y: 0.0, z: 1.0})
    return v3_normalize(t)
}

pub fn bitangent_for_normal(n: Vec3, tangent: Vec3) Vec3 = {
    return v3_normalize(v3_cross(n, tangent))
}

pub fn mat4_identity() Mat4 = {
    return Mat4{
        m00: 1.0, m01: 0.0, m02: 0.0, m03: 0.0
        m10: 0.0, m11: 1.0, m12: 0.0, m13: 0.0
        m20: 0.0, m21: 0.0, m22: 1.0, m23: 0.0
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    }
}

pub fn mat4_zero() Mat4 = {
    return Mat4{
        m00: 0.0, m01: 0.0, m02: 0.0, m03: 0.0
        m10: 0.0, m11: 0.0, m12: 0.0, m13: 0.0
        m20: 0.0, m21: 0.0, m22: 0.0, m23: 0.0
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 0.0
    }
}

pub fn mat4_mul(a: Mat4, b: Mat4) Mat4 = {
    return Mat4{
        m00: a.m00*b.m00 + a.m01*b.m10 + a.m02*b.m20 + a.m03*b.m30
        m01: a.m00*b.m01 + a.m01*b.m11 + a.m02*b.m21 + a.m03*b.m31
        m02: a.m00*b.m02 + a.m01*b.m12 + a.m02*b.m22 + a.m03*b.m32
        m03: a.m00*b.m03 + a.m01*b.m13 + a.m02*b.m23 + a.m03*b.m33
        m10: a.m10*b.m00 + a.m11*b.m10 + a.m12*b.m20 + a.m13*b.m30
        m11: a.m10*b.m01 + a.m11*b.m11 + a.m12*b.m21 + a.m13*b.m31
        m12: a.m10*b.m02 + a.m11*b.m12 + a.m12*b.m22 + a.m13*b.m32
        m13: a.m10*b.m03 + a.m11*b.m13 + a.m12*b.m23 + a.m13*b.m33
        m20: a.m20*b.m00 + a.m21*b.m10 + a.m22*b.m20 + a.m23*b.m30
        m21: a.m20*b.m01 + a.m21*b.m11 + a.m22*b.m21 + a.m23*b.m31
        m22: a.m20*b.m02 + a.m21*b.m12 + a.m22*b.m22 + a.m23*b.m32
        m23: a.m20*b.m03 + a.m21*b.m13 + a.m22*b.m23 + a.m23*b.m33
        m30: a.m30*b.m00 + a.m31*b.m10 + a.m32*b.m20 + a.m33*b.m30
        m31: a.m30*b.m01 + a.m31*b.m11 + a.m32*b.m21 + a.m33*b.m31
        m32: a.m30*b.m02 + a.m31*b.m12 + a.m32*b.m22 + a.m33*b.m32
        m33: a.m30*b.m03 + a.m31*b.m13 + a.m32*b.m23 + a.m33*b.m33
    }
}

pub fn mat4_perspective(fovy: f64, aspect: f64, near_plane: f64, far_plane: f64) Mat4 = {
    val f = 1.0 / math.tan(fovy * 0.5)
    return Mat4{
        m00: f / aspect, m01: 0.0, m02: 0.0, m03: 0.0
        m10: 0.0, m11: f, m12: 0.0, m13: 0.0
        m20: 0.0, m21: 0.0, m22: (far_plane + near_plane) / (near_plane - far_plane)
        m23: -1.0
        m30: 0.0, m31: 0.0
        m32: (2.0 * far_plane * near_plane) / (near_plane - far_plane)
        m33: 0.0
    }
}

pub fn mat4_ortho(
    left: f64,
    right: f64,
    bottom: f64,
    top: f64,
    near_plane: f64,
    far_plane: f64
) Mat4 = {
    return Mat4{
        m00: 2.0 / (right - left), m01: 0.0, m02: 0.0, m03: 0.0
        m10: 0.0, m11: 2.0 / (top - bottom), m12: 0.0, m13: 0.0
        m20: 0.0, m21: 0.0, m22: -2.0 / (far_plane - near_plane), m23: 0.0
        m30: -(right + left) / (right - left)
        m31: -(top + bottom) / (top - bottom)
        m32: -(far_plane + near_plane) / (far_plane - near_plane)
        m33: 1.0
    }
}

pub fn mat4_look_at(eye: Vec3, target: Vec3, up: Vec3) Mat4 = {
    val f = v3_normalize(v3_sub(target, eye))
    val s = v3_normalize(v3_cross(f, up))
    val u = v3_cross(s, f)
    return Mat4{
        m00: s.x, m01: s.y, m02: s.z, m03: -v3_dot(s, eye)
        m10: u.x, m11: u.y, m12: u.z, m13: -v3_dot(u, eye)
        m20: -f.x, m21: -f.y, m22: -f.z, m23: v3_dot(f, eye)
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    }
}

// Writes column-major f32 values, ready for glLoadMatrixf.
pub fn mat4_write_f32(m: Mat4, out: ref void) void = {
    mem.set_f32(out, 0, m.m00 as f32)
    mem.set_f32(out, 1, m.m10 as f32)
    mem.set_f32(out, 2, m.m20 as f32)
    mem.set_f32(out, 3, m.m30 as f32)
    mem.set_f32(out, 4, m.m01 as f32)
    mem.set_f32(out, 5, m.m11 as f32)
    mem.set_f32(out, 6, m.m21 as f32)
    mem.set_f32(out, 7, m.m31 as f32)
    mem.set_f32(out, 8, m.m02 as f32)
    mem.set_f32(out, 9, m.m12 as f32)
    mem.set_f32(out, 10, m.m22 as f32)
    mem.set_f32(out, 11, m.m32 as f32)
    mem.set_f32(out, 12, m.m03 as f32)
    mem.set_f32(out, 13, m.m13 as f32)
    mem.set_f32(out, 14, m.m23 as f32)
    mem.set_f32(out, 15, m.m33 as f32)
}

pub fn mat4_write_f64(m: Mat4, out: ref void) void = {
    mem.set_f64(out, 0, m.m00)
    mem.set_f64(out, 1, m.m10)
    mem.set_f64(out, 2, m.m20)
    mem.set_f64(out, 3, m.m30)
    mem.set_f64(out, 4, m.m01)
    mem.set_f64(out, 5, m.m11)
    mem.set_f64(out, 6, m.m21)
    mem.set_f64(out, 7, m.m31)
    mem.set_f64(out, 8, m.m02)
    mem.set_f64(out, 9, m.m12)
    mem.set_f64(out, 10, m.m22)
    mem.set_f64(out, 11, m.m32)
    mem.set_f64(out, 12, m.m03)
    mem.set_f64(out, 13, m.m13)
    mem.set_f64(out, 14, m.m23)
    mem.set_f64(out, 15, m.m33)
}
