pub type Color = {
    r: mut f32
    g: mut f32
    b: mut f32
    a: mut f32
}

pub fn color(r: f32, g: f32, b: f32, a: f32) Color = {
    return Color{r: r, g: g, b: b, a: a}
}

pub fn color_rgb(r: f32, g: f32, b: f32) Color = {
    return Color{r: r, g: g, b: b, a: 1.0}
}

pub fn color_with_alpha(c: Color, a: f32) Color = {
    return Color{r: c.r, g: c.g, b: c.b, a: a}
}

pub fn color_mix(a: Color, b: Color, t: f32) Color = {
    return Color{
        r: a.r + (b.r - a.r) * t
        g: a.g + (b.g - a.g) * t
        b: a.b + (b.b - a.b) * t
        a: a.a + (b.a - a.a) * t
    }
}

pub fn color_scale(c: Color, s: f32) Color = {
    return Color{r: c.r * s, g: c.g * s, b: c.b * s, a: c.a}
}
