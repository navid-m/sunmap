val draw2d   = use("../render/draw2d.sx")
val text     = use("../render/text.sx")
val theme    = use("../render/theme.sx")
val color    = use("../core/color.sx")
val math     = use("../core/math.sx")
val str      = use("../core/strutil.sx")
val c        = use("../core/constants.sx")
val brush    = use("../map/brush.sx")
val world    = use("../map/world.sx")
val camera   = use("../render/camera.sx")
val input    = use("../platform/input.sx")
val uistate  = use("./state.sx")
val project  = use("../io/project.sx")
val exporter = use("../io/export.sx")

pub fn over_ui(mx: i32, my: i32, width: i32, height: i32) bool = {
    if my < c.TOP_BAR_H {
        return true
    }
    if my > height - c.BOTTOM_BAR_H {
        return true
    }
    if mx < c.LEFT_PANEL_W {
        return true
    }
    if mx > width - c.RIGHT_PANEL_W {
        return true
    }
    return false
}

fn inside(mx: i32, my: i32, x: i32, y: i32, w: i32, h: i32) bool = {
    return mx >= x && my >= y && mx < x + w && my < y + h
}

fn button(
    inp: mut ref input.Input,
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    label: ref u8,
    active: bool
) bool = trust {
    val hover = inside(inp.mx, inp.my, x, y, w, h)
    val bg: mut color.Color = theme.PANEL_2()
    if active {
        bg = theme.ACCENT_DIM()
    }
    if hover {
        if active {
            bg = color.color_mix(theme.ACCENT_DIM(), theme.ACCENT(), 0.25)
        } else {
            bg = theme.PANEL_HOVER()
        }
    }
    draw2d.rect(x, y, w, h, bg)
    if active {
        draw2d.rect_outline(x, y, w, h, 1, theme.ACCENT())
    } else {
        draw2d.rect_outline(x, y, w, h, 1, theme.BORDER_SOFT())
    }
    val ty = y + (h - text.height(0, label)) / 2 - 1
    draw2d.text_centered(0, x + w / 2, ty, label, theme.TEXT())
    if hover && inp.clicked_left {
        inp.clicked_left = false
        return true
    }
    return false
}

fn small_button(
    inp: mut ref input.Input,
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    label: ref u8
) bool = trust {
    return button(inp, x, y, w, h, label, false)
}

fn bump_grid(ui: mut ref uistate.UIState, up: bool) void = {
    if up {
        if ui.grid < 256.0 {
            ui.grid = ui.grid * 2.0
        }
    } else {
        if ui.grid > 1.0 {
            ui.grid = ui.grid / 2.0
        }
    }
}

fn bump_wall(ui: mut ref uistate.UIState, up: bool) void = {
    if up {
        if ui.wall < 64.0 {
            ui.wall = ui.wall + 4.0
        }
    } else {
        if ui.wall > 4.0 {
            ui.wall = ui.wall - 4.0
        }
    }
}

fn bump_height(ui: mut ref uistate.UIState, up: bool) void = {
    if up {
        if ui.height < 512.0 {
            ui.height = ui.height + 16.0
        }
    } else {
        if ui.height > 16.0 {
            ui.height = ui.height - 16.0
        }
    }
}

fn format_f64(buf: ref u8, cap: i32, value: f64) void = {
    val rounded = math.round(value * 10.0) / 10.0
    @snprintf(buf, cap, "{f}", {rounded})
}

pub fn commit_name(w: mut ref world.World, ui: mut ref uistate.UIState) void = {
    val safe: mut [64]u8 = @zeroed
    str.sanitize(@addr(safe) as ref u8, 64, world.name(w))
    world.copy_name(w, @addr(safe) as ref u8)
    ui.editing_name = false
}

fn single_selected(w: mut ref world.World) ref brush.Brush = {
    if world.selected_count(w) != 1 {
        return none
    }
    val i: mut i32 = 0
    for {
        if i >= w.brush_count {
            break
        }
        val b = world.brush_at(w, i)
        if b.selected {
            return b
        }
        i++
    }
    return none
}

fn draw_texture_panel(
    w: mut ref world.World,
    ui: mut ref uistate.UIState,
    inp: mut ref input.Input,
    x: i32,
    y: i32,
    width: i32,
    height: i32
) void = trust {
    draw2d.text_draw(1, x + 16, y + 14, "TEXTURES", theme.TEXT())
    val count_buf: mut [32]u8 = @zeroed
    @snprintf(@addr(count_buf) as ref u8, 32, "{d} loaded", {w.texture_count - 1})
    draw2d.text_right(0, x + width - 16, y + 17, @addr(count_buf) as ref u8, theme.MUTED())
    draw2d.rect(x + 12, y + 40, width - 24, 1, theme.BORDER_SOFT())

    val list_y = y + 52
    val list_h = height - 74
    draw2d.rect(x + 12, list_y, width - 24, list_h, theme.PANEL())
    draw2d.clip(x + 12, list_y, width - 24, list_h)
    draw2d.rect_outline(x + 12, list_y, width - 24, list_h, 1, theme.BORDER_SOFT())

    val cell_w: i32 = 104
    val cell_h: i32 = 128
    val gap: i32 = 8
    val pad: i32 = 8
    val scroll = ui.texture_scroll as i32
    val i: mut i32 = 0
    for {
        if i >= w.texture_count {
            break
        }
        val col = i % 2
        val row = i / 2
        val tx = x + 12 + pad + col * (cell_w + gap)
        val ty = list_y + pad + row * (cell_h + gap) - scroll
        if ty > list_y + list_h || ty + cell_h < list_y {
            i++
        } else {
            val t = world.texture_at(w, i)
            val selected = i == ui.active_tex
            draw2d.rect(tx, ty, cell_w, cell_h, theme.PANEL_2())
            if selected {
                draw2d.rect_outline(tx, ty, cell_w, cell_h, 2, theme.ACCENT())
            } else {
                draw2d.rect_outline(tx, ty, cell_w, cell_h, 1, theme.BORDER_SOFT())
            }
            draw2d.image(t.gl, tx + 4, ty + 4, cell_w - 8, cell_w - 8, theme.WHITE())
            draw2d.rect(tx + 4, ty + cell_w + 2, cell_w - 8, 1, theme.BORDER_SOFT())
            draw2d.text_centered(0, tx + cell_w / 2, ty + cell_w + 8, t.name, theme.TEXT())
            if inside(inp.mx, inp.my, tx, ty, cell_w, cell_h) && inp.clicked_left {
                ui.active_tex = i
                if world.selected_count(w) > 0 {
                    world.apply_texture(w, i)
                    uistate.set_status(ui, "Applied {s} to selection", {t.name})
                } elif ui.face_brush >= 0 && ui.face_brush < w.brush_count {
                    val fb: mut ref brush.Brush = world.brush_at(w, ui.face_brush)
                    fb.tex = i
                    uistate.set_status(ui, "Applied {s} to face", {t.name})
                } else {
                    uistate.set_status(ui, "Active texture: {s}", {t.name})
                }
                inp.clicked_left = false
            }
            i++
        }
    }
    draw2d.clip_off()

    // scrollbar hint
    if w.texture_count > 4 {
        val rows = (w.texture_count + 1) / 2
        val total_h = rows * (cell_h + gap) + pad * 2
        if total_h > list_h {
            val max_scroll = (total_h - list_h) as f64
            if ui.texture_scroll > max_scroll {
                ui.texture_scroll = max_scroll
            }
            val bar_h = (list_h * list_h / total_h) as i32
            val bar_y = list_y + ((list_h - bar_h) as f64 * (ui.texture_scroll / max_scroll)) as i32
            draw2d.rect(x + width - 18, bar_y, 3, bar_h, theme.BORDER())
        }
    }

    draw2d.text_draw(0, x + 16, y + height - 20, "Drag & drop PNG / TGA / JPG / BMP", theme.MUTED())
}

fn draw_inspector(
    w: mut ref world.World,
    ui: mut ref uistate.UIState,
    inp: mut ref input.Input,
    cam: ref camera.Camera,
    x: i32,
    y: i32,
    width: i32,
    _: i32
) void = trust {
    draw2d.text_draw(1, x + 16, y + 14, "INSPECTOR", theme.TEXT())
    draw2d.rect(x + 12, y + 40, width - 24, 1, theme.BORDER_SOFT())

    val px = x + 16
    val pw = width - 32
    val row: mut i32 = y + 54

    // Project name
    draw2d.text_draw(0, px, row, "PROJECT", theme.MUTED())
    row += 18
    draw2d.rect(px, row, pw, 30, theme.PANEL())
    val name_border: mut color.Color = theme.BORDER_SOFT()
    if ui.editing_name {
        name_border = theme.ACCENT()
    }
    draw2d.rect_outline(px, row, pw, 30, 1, name_border)
    draw2d.text_draw(0, px + 8, row + 8, world.name(w), theme.TEXT())
    if ui.editing_name {
        val nw = text.width(0, world.name(w))
        draw2d.rect(px + 8 + nw + 1, row + 7, 1, 16, theme.ACCENT())
    }
    if inside(inp.mx, inp.my, px, row, pw, 30) && inp.clicked_left {
        ui.editing_name = true
        inp.clicked_left = false
    }
    row += 40

    // selection info
    val selected = world.selected_count(w)
    val sel_buf: mut [64]u8 = @zeroed
    if selected == 0 {
        str.copy(@addr(sel_buf) as ref u8, 64, "No selection")
    } elif selected == 1 {
        str.copy(@addr(sel_buf) as ref u8, 64, "1 brush selected")
    } else {
        @snprintf(@addr(sel_buf) as ref u8, 64, "{d} brushes selected", {selected})
    }
    val sel_color: mut color.Color = theme.MUTED()
    if selected > 0 {
        sel_color = theme.ACCENT()
    }
    draw2d.text_draw(0, px, row, @addr(sel_buf) as ref u8, sel_color)
    row += 22

    val one = single_selected(w)
    if one != none {
        val sz = brush.size(one)
        val org = brush.origin(one)
        val b1: mut [96]u8 = @zeroed
        val b2: mut [96]u8 = @zeroed
        @snprintf(@addr(b1) as ref u8, 96, "Size  {f} x {f} x {f}", {sz.x, sz.y, sz.z})
        @snprintf(@addr(b2) as ref u8, 96, "Center  {f}  {f}  {f}", {org.x, org.y, org.z})
        draw2d.text_draw(0, px, row, @addr(b1) as ref u8, theme.MUTED())
        draw2d.text_draw(0, px, row + 16, @addr(b2) as ref u8, theme.MUTED())
        row += 40
    } else {
        row += 4
    }

    draw2d.rect(x + 12, row, width - 24, 1, theme.BORDER_SOFT())
    row += 14

    // grid
    draw2d.text_draw(0, px, row + 7, "Grid", theme.MUTED())
    val gb: mut [32]u8 = @zeroed
    @snprintf(@addr(gb) as ref u8, 32, "{d}", {ui.grid as i32})
    if small_button(inp, px + pw - 96, row, 28, 28, "-") {
        bump_grid(ui, false)
    }
    draw2d.rect(px + pw - 66, row, 40, 28, theme.PANEL())
    draw2d.text_centered(0, px + pw - 46, row + 7, @addr(gb) as ref u8, theme.TEXT())
    if small_button(inp, px + pw - 24, row, 24, 28, "+") {
        bump_grid(ui, true)
    }
    row += 34

    // wall
    draw2d.text_draw(0, px, row + 7, "Wall", theme.MUTED())
    val wb: mut [32]u8 = @zeroed
    @snprintf(@addr(wb) as ref u8, 32, "{d}", {ui.wall as i32})
    if small_button(inp, px + pw - 96, row, 28, 28, "-") {
        bump_wall(ui, false)
    }
    draw2d.rect(px + pw - 66, row, 40, 28, theme.PANEL())
    draw2d.text_centered(0, px + pw - 46, row + 7, @addr(wb) as ref u8, theme.TEXT())
    if small_button(inp, px + pw - 24, row, 24, 28, "+") {
        bump_wall(ui, true)
    }
    row += 34

    // height
    draw2d.text_draw(0, px, row + 7, "Height", theme.MUTED())
    val hb: mut [32]u8 = @zeroed
    @snprintf(@addr(hb) as ref u8, 32, "{d}", {ui.height as i32})
    if small_button(inp, px + pw - 96, row, 28, 28, "-") {
        bump_height(ui, false)
    }
    draw2d.rect(px + pw - 66, row, 40, 28, theme.PANEL())
    draw2d.text_centered(0, px + pw - 46, row + 7, @addr(hb) as ref u8, theme.TEXT())
    if small_button(inp, px + pw - 24, row, 24, 28, "+") {
        bump_height(ui, true)
    }
    row += 40

    draw2d.rect(x + 12, row, width - 24, 1, theme.BORDER_SOFT())
    row += 14

    // CSG buttons
    draw2d.text_draw(0, px, row, "CSG", theme.MUTED())
    row += 18
    if button(inp, px, row, pw, 30, "Hollow selection", false) {
        if world.selected_count(w) == 0 {
            uistate.set_status(ui, "Select a brush before hollowing.", {})
        } else {
            val made = world.hollow_selected(w, ui.wall)
            uistate.set_status(ui, "Hollow created {d} wall brushes.", {made})
            ui.face_brush = -1
            ui.face_index = -1
        }
    }
    row += 36
    if button(inp, px, row, pw, 30, "CSG subtract", false) {
        val made = world.subtract_selected(w)
        if made > 0 {
            uistate.set_status(ui, "Subtract created {d} brushes.", {made})
        } else {
            uistate.set_status(ui, "Select a cutter brush first.", {})
        }
    }
    row += 36
    if button(inp, px, row, pw / 2 - 3, 28, "Merge", false) {
        if world.merge_selected(w) {
            uistate.set_status(ui, "Merged selection.", {})
        } else {
            uistate.set_status(ui, "Merge needs 2+ selected brushes.", {})
        }
    }
    if button(inp, px + pw / 2 + 3, row, pw / 2 - 3, 28, "Intersect", false) {
        if world.intersect_selected(w) {
            uistate.set_status(ui, "Intersected selection.", {})
        } else {
            uistate.set_status(ui, "Intersect needs 2 selected brushes.", {})
        }
    }
    row += 40

    draw2d.rect(x + 12, row, width - 24, 1, theme.BORDER_SOFT())
    row += 14

    // active texture
    val ati: mut i32 = 0
    if ui.active_tex >= 0 && ui.active_tex < w.texture_count {
        ati = ui.active_tex
    }
    val at = world.texture_at(w, ati)
    draw2d.text_draw(0, px, row, "ACTIVE TEXTURE", theme.MUTED())
    row += 18
    draw2d.rect(px, row, pw, 30, theme.PANEL())
    draw2d.rect_outline(px, row, pw, 30, 1, theme.BORDER_SOFT())
    draw2d.image(at.gl, px + 3, row + 3, 24, 24, theme.WHITE())
    draw2d.text_draw(0, px + 34, row + 8, at.name, theme.TEXT())
    row += 40

    // exports
    draw2d.text_draw(0, px, row, "EXPORT", theme.MUTED())
    row += 18
    if button(inp, px, row, pw, 30, "Export all formats", true) {
        if exporter.export_all(w) {
            uistate.set_status(ui, "Exported to exports/{s}/", {world.name(w)})
        } else {
            uistate.set_status(ui, "Export failed.", {})
        }
    }
    row += 36
    if button(inp, px, row, pw / 2 - 3, 28, ".MAP", false) {
        if exporter.export_map(w) {
            uistate.set_status(ui, "Wrote Quake .map", {})
        }
    }
    if button(inp, px + pw / 2 + 3, row, pw / 2 - 3, 28, "OBJ", false) {
        if exporter.export_obj(w) {
            uistate.set_status(ui, "Wrote .obj + .mtl", {})
        }
    }
    row += 34
    if button(inp, px, row, pw / 2 - 3, 28, "glTF", false) {
        if exporter.export_gltf(w) {
            uistate.set_status(ui, "Wrote .gltf", {})
        }
    }
    if button(inp, px + pw / 2 + 3, row, pw / 2 - 3, 28, "GLB", false) {
        if exporter.export_glb(w) {
            uistate.set_status(ui, "Wrote .glb", {})
        }
    }
    row += 38

    draw2d.rect(x + 12, row, width - 24, 1, theme.BORDER_SOFT())
    row += 12

    // camera speed
    val spd: mut [64]u8 = @zeroed
    @snprintf(@addr(spd) as ref u8, 64, "Fly speed  {d} u/s", {cam.speed as i32})
    draw2d.text_draw(0, px, row, @addr(spd) as ref u8, theme.MUTED())
    row += 16
    draw2d.text_draw(0, px, row, "Wheel: grid   RMB: look", theme.DIM())
    row += 16
    draw2d.text_draw(0, px, row, "WASD + Shift: noclip", theme.DIM())
    row += 16
    draw2d.text_draw(0, px, row, "V: vertex edit mode", theme.DIM())
}

pub fn draw(
    w: mut ref world.World,
    cam: mut ref camera.Camera,
    ui: mut ref uistate.UIState,
    inp: mut ref input.Input,
    width: i32,
    height: i32
) void = trust {
    draw2d.begin(width, height)

    // Panels only: the 3D viewport is already drawn underneath.
    draw2d.rect(0, 0, width, c.TOP_BAR_H, theme.PANEL())
    draw2d.rect(
        0,
        c.TOP_BAR_H,
        c.LEFT_PANEL_W,
        height - c.TOP_BAR_H - c.BOTTOM_BAR_H,
        theme.PANEL()
    )
    draw2d.rect(
        width - c.RIGHT_PANEL_W,
        c.TOP_BAR_H,
        c.RIGHT_PANEL_W,
        height - c.TOP_BAR_H - c.BOTTOM_BAR_H,
        theme.PANEL()
    )
    draw2d.rect(0, height - c.BOTTOM_BAR_H, width, c.BOTTOM_BAR_H, theme.PANEL())
    draw2d.rect(0, c.TOP_BAR_H - 1, width, 1, theme.BORDER())
    draw2d.rect(
        c.LEFT_PANEL_W - 1,
        c.TOP_BAR_H,
        1,
        height - c.TOP_BAR_H - c.BOTTOM_BAR_H,
        theme.BORDER()
    )
    draw2d.rect(
        width - c.RIGHT_PANEL_W,
        c.TOP_BAR_H,
        1,
        height - c.TOP_BAR_H - c.BOTTOM_BAR_H,
        theme.BORDER()
    )
    draw2d.rect(0, height - c.BOTTOM_BAR_H, width, 1, theme.BORDER())

    // Logo
    draw2d.rect(16, 13, 26, 26, theme.ACCENT())
    draw2d.text_centered(1, 29, 16, "S", theme.BG())
    draw2d.text_draw(1, 52, 17, "sunmap", theme.TEXT())
    draw2d.text_draw(0, 118, 22, "level editor", theme.DIM())

    // Mode segmented control
    val base_x: i32 = 196
    val seg_w: i32 = 74
    if button(inp, base_x, 11, seg_w, 30, "Brush", ui.mode == c.MODE_BRUSH) {
        ui.mode = c.MODE_BRUSH
        ui.face_brush = -1
        ui.face_index = -1
    }
    if button(inp, base_x + seg_w + 4, 11, seg_w, 30, "Face", ui.mode == c.MODE_FACE) {
        ui.mode = c.MODE_FACE
    }
    if button(inp, base_x + 2 * (seg_w + 4), 11, seg_w, 30, "Vertex", ui.mode == c.MODE_VERTEX) {
        ui.mode = c.MODE_VERTEX
    }

    // top right actions
    val rx = width - 16
    if button(inp, rx - 82, 11, 82, 30, "Export", true) {
        if exporter.export_all(w) {
            uistate.set_status(ui, "Exported to exports/{s}/", {world.name(w)})
        }
    }
    if button(inp, rx - 166, 11, 78, 30, "Save", false) {
        if project.save(w, cam, ui) {
            uistate.set_status(ui, "Saved projects/{s}.sm", {world.name(w)})
        } else {
            uistate.set_status(ui, "Save failed.", {})
        }
    }
    if button(inp, rx - 250, 11, 78, 30, "Load", false) {
        if project.load(w, cam, ui) {
            uistate.set_status(ui, "Loaded projects/{s}.sm", {world.name(w)})
        } else {
            uistate.set_status(ui, "No project file for {s}.", {world.name(w)})
        }
    }

    // Project label in top bar
    val proj_buf: mut [96]u8 = @zeroed
    @snprintf(@addr(proj_buf) as ref u8, 96, "{s}.sm", {world.name(w)})
    draw2d.text_right(0, rx - 268, 22, @addr(proj_buf) as ref u8, theme.MUTED())

    draw_texture_panel(
        w,
        ui,
        inp,
        0,
        c.TOP_BAR_H,
        c.LEFT_PANEL_W,
        height - c.TOP_BAR_H - c.BOTTOM_BAR_H
    )
    draw_inspector(
        w,
        ui,
        inp,
        cam,
        width - c.RIGHT_PANEL_W,
        c.TOP_BAR_H,
        c.RIGHT_PANEL_W,
        height - c.TOP_BAR_H - c.BOTTOM_BAR_H
    )

    // Bottom status bar
    draw2d.text_draw(0, 14, height - c.BOTTOM_BAR_H + 8, uistate.status(ui), theme.MUTED())
    val modeb: mut [96]u8 = @zeroed
    @snprintf(@addr(modeb) as ref u8, 96, "{s} mode   grid {d}   height {d}", {
            uistate.mode_name(ui.mode), ui.grid as i32, ui.height as i32
        })
    draw2d.text_right(
        0,
        width - 16,
        height - c.BOTTOM_BAR_H + 8,
        @addr(modeb) as ref u8,
        theme.DIM()
    )

    // Help overlay
    if ui.help_visible {
        val hw: i32 = 330
        val hh: i32 = 176
        val hx = c.LEFT_PANEL_W + 18
        val hy = height - c.BOTTOM_BAR_H - hh - 18
        draw2d.rect(hx, hy, hw, hh, color.color(0.06, 0.07, 0.085, 0.88))
        draw2d.rect_outline(hx, hy, hw, hh, 1, theme.BORDER())
        draw2d.text_draw(1, hx + 14, hy + 10, "Controls", theme.TEXT())
        draw2d.text_draw(0, hx + 14, hy + 40, "LMB drag        draw / move", theme.MUTED())
        draw2d.text_draw(
            0,
            hx + 14,
            hy + 58,
            "Shift + LMB     extrude / intrude face",
            theme.MUTED()
        )
        draw2d.text_draw(0, hx + 14, hy + 76, "V               vertex edit mode", theme.MUTED())
        draw2d.text_draw(
            0,
            hx + 14,
            hy + 94,
            "WASD + RMB      fly / look (Shift = fast)",
            theme.MUTED()
        )
        draw2d.text_draw(0, hx + 14, hy + 112, "Arrows          nudge selection", theme.MUTED())
        draw2d.text_draw(0, hx + 14, hy + 130, "Ctrl+H          hollow selection", theme.MUTED())
        draw2d.text_draw(
            0,
            hx + 14,
            hy + 148,
            "Del / Ctrl+S / Ctrl+O   delete / save / load",
            theme.DIM()
        )
    }

    draw2d.end()
}
